<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fcfaf8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#f57c0d">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tableau de bord Admin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvAdminSubheader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WASSIL Algérie • Synchronisé Cloud"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefreshDashboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFF"
            android:contentDescription="Actualiser"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Stats Row 1: Orders & Revenue -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Total Orders Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tvTotalOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#f57c0d"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Commandes totales"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <!-- Total Revenue Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/tvTotalRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 DA"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revenus livrés (GMV)"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Stats Row 2: Active Couriers & In-Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Active Couriers Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tvActiveDeliveries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Livreurs actifs"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <!-- Ongoing Deliveries Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFFFFF"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/tvOngoingDeliveries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#9C27B0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Courses en cours"
                        android:textSize="11sp"
                        android:textColor="#757575"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Platform Commission KPI Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:radius="12dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💼 Commissions Plateforme"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />

                        <TextView
                            android:id="@+id/tvAdminCommissionRateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Taux : 15%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#5E35B1"
                            android:background="#EDE7F6"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Platform Commission Amount -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#F3E5F5"
                            android:padding="10dp"
                            android:layout_marginEnd="5dp">

                            <TextView
                                android:id="@+id/tvPlatformCommissionTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 DA"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#6A1B9A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Part plateforme"
                                android:textSize="10sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <!-- Courier Net Earnings -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#E8F5E9"
                            android:padding="10dp"
                            android:layout_marginStart="5dp">

                            <TextView
                                android:id="@+id/tvCourierNetTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 DA"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenu net livreurs"
                                android:textSize="10sp"
                                android:textColor="#757575" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Map Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗺 Carte en direct des livraisons"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/tvMapLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔵 Départ  🔴 Arrivée  🟠 Livreur"
                    android:textSize="10sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Mapbox Map View Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="230dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.mapbox.maps.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvMapStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="8dp"
                        android:background="#CC000000"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:text="Chargement de la carte..."/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Active Couriers Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 Livreurs enregistrés (Cloud)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="8dp"/>

            <!-- Active Couriers List Container -->
            <LinearLayout
                android:id="@+id/llActiveDeliveries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginBottom="16dp"/>

            <!-- Recent Orders Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Commandes plateforme"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="8dp"/>

            <!-- Order Search Input -->
            <EditText
                android:id="@+id/etOrderSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Rechercher par n°, client, livreur, wilaya..."
                android:textSize="13sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- Order Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="10dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupOrderFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toutes"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En attente"
                        style="@style/Widget.MaterialComponents.Chip.Choice"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterOngoing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En cours"
                        style="@style/Widget.MaterialComponents.Chip.Choice"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterDelivered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terminées"
                        style="@style/Widget.MaterialComponents.Chip.Choice"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterCancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Annulées"
                        style="@style/Widget.MaterialComponents.Chip.Choice"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Recent Orders Empty Text -->
            <TextView
                android:id="@+id/tvOrdersEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucune commande trouvée"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"/>

            <!-- Recent Orders List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecentOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="8dp"/>

            <!-- Load More / Show Less Button -->
            <Button
                android:id="@+id/btnToggleOrdersLimit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Afficher plus de commandes (0 restantes)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#f57c0d"
                android:backgroundTint="#FFF3E0"
                android:visibility="gone"
                android:layout_marginBottom="20dp"/>

            <!-- Action Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Tâches d'administration"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="8dp"/>

            <!-- Vérification d'identité des livreurs (KYC) with Badge -->
            <Button
                android:id="@+id/btnManageKyc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Vérifications d'identité (KYC)"
                android:backgroundTint="#00897B"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Gestion des retraits with Badge -->
            <Button
                android:id="@+id/btnManageWithdrawals"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Gérer les retraits"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Gestion des commissions -->
            <Button
                android:id="@+id/btnManageCommissions"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="💼 Gestion des commissions (15%)"
                android:backgroundTint="#5E35B1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Déconnexion"
                android:backgroundTint="#f57c0d"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>