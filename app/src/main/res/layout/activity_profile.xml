<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fcfaf8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#f57c0d">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textSize="24sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profil"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- User Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Karim Boudjema"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/tvProfileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expéditeur"
                    android:textSize="14sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp">

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Téléphone"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+213 555 123 456"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="karim@example.com"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Wilaya -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wilaya"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfileWilaya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alger - Sidi M'Hamed"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Vehicle (for delivery only) -->
                <LinearLayout
                    android:id="@+id/layoutVehicle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Véhicule"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfileVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moto"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Rating (for delivery only) -->
                <LinearLayout
                    android:id="@+id/layoutRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Note"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfileRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8 ★"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Balance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solde"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:id="@+id/tvProfileBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4500 DA"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#fec87e"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Add Balance Button (for sender only) -->
            <Button
                android:id="@+id/btnAddBalance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ajouter du crédit"
                android:backgroundTint="#fcfaf8"
                android:textColor="#757575"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <!-- Edit Profile Button -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Modifier le profil"
                android:backgroundTint="#fcfaf8"
                android:textColor="#757575"
                android:layout_marginTop="16dp"/>

            <!-- Identity verification. Shown only to couriers: a sender has no
                 documents to submit. Visibility is decided in ProfileActivity. -->
            <Button
                android:id="@+id/btnKycVerification"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Vérification d'identité"
                android:backgroundTint="#fcfaf8"
                android:textColor="#757575"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Déconnexion"
                android:backgroundTint="#fcfaf8"
                android:textColor="#757575"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation with Icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_inactive"
                android:tint="#757575"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accueil"
                android:textSize="11sp"
                android:textColor="#757575"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:tint="#757575"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historique"
                android:textSize="11sp"
                android:textColor="#757575"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>