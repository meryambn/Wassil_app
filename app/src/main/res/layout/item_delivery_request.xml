<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Package Type and Weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvPackageType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Électronique"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 kg"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121"/>
    </LinearLayout>

    <!-- Pickup Address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="➡️"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvPickupAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 Place Audin, Alger Centre"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Drop Address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvDropAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="17 Rue de Tripoli, Hydra"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Price -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="450 DA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#f57c0d"
        android:layout_marginBottom="12dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRefuse"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Refuser"
            android:backgroundTint="#213451"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Faire une offre"
            android:textSize="12sp"
            android:backgroundTint="#fec87e"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>