<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fcfaf8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#f57c0d">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textSize="24sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Détails livraison"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Navigation GPS Button -->
            <Button
                android:id="@+id/btnGPS"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Navigation GPS"
                android:backgroundTint="#f57c0d"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Order Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <!-- Order ID -->
                <TextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WSL-2026-C4L8R"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#f57c0d"
                    android:layout_marginBottom="8dp"/>

                <!-- Price -->
                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="450 DA"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#fec87e"
                    android:layout_marginBottom="16dp"/>

                <!-- Pickup Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="➡️"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvPickupAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 Place Audin, Alger Centre"
                        android:textSize="14sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <!-- Drop Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvDropAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="17 Rue de Tripoli, Hydra"
                        android:textSize="14sp"
                        android:textColor="#757575"/>
                </LinearLayout>

                <!-- Details Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F5F5F5"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type"
                            android:textSize="12sp"
                            android:textColor="#757575"/>

                        <TextView
                            android:id="@+id/tvPackageType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Électronique"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#212121"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Poids"
                            android:textSize="12sp"
                            android:textColor="#757575"/>

                        <TextView
                            android:id="@+id/tvWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 kg"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#212121"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urgence"
                            android:textSize="12sp"
                            android:textColor="#757575"/>

                        <TextView
                            android:id="@+id/tvUrgency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Express"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#f57c0d"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Contact Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnCall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Appeler"
                    android:backgroundTint="#fec87e"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnWhatsApp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="WhatsApp"
                    android:backgroundTint="#fec87e"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Start Delivery Button -->
            <Button
                android:id="@+id/btnStartDelivery"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Commencer la livraison"
                android:backgroundTint="#f57c0d"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>