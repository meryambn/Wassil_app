<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fcfaf8"
    android:padding="16dp">

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Retour"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:textColor="#f57c0d"/>

    <!-- Payment Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paiement sécurisé"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#f57c0d"
                android:layout_marginBottom="16dp"/>

            <!-- Order Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commande:"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/tvPaymentOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WSL-2026-XXX"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="16dp"/>

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Montant à payer:"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/tvPaymentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="350 DA"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#fec87e"
                android:layout_marginBottom="24dp"/>

            <!-- Balance -->
            <TextView
                android:id="@+id/tvCurrentBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solde actuel: 4500 DA"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="24dp"/>

            <!-- Payment Methods Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode de paiement"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp"/>

            <!-- Payment Options -->
            <RadioGroup
                android:id="@+id/rgPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- Wallet was implemented in code but had no radio button, so the
                     branch was unreachable. It is a real, working method now. -->
                <RadioButton
                    android:id="@+id/rbWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Portefeuille WASSIL"
                    android:textSize="16sp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"/>

                <RadioButton
                    android:id="@+id/rbCash"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Espèces à la livraison"
                    android:textColor="#212121"
                    android:padding="8dp"/>

                <RadioButton
                    android:id="@+id/rbCard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="💳 Carte bancaire"
                    android:textColor="#212121"
                    android:padding="8dp"/>

                <RadioButton
                    android:id="@+id/rbCIB"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🏦 CIB"
                    android:textColor="#212121"
                    android:padding="8dp"/>

                <RadioButton
                    android:id="@+id/rbEdahabia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📱 Edahabia"
                    android:textColor="#212121"
                    android:padding="8dp"/>
            </RadioGroup>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelPayment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Annuler"
                    android:backgroundTint="#9E9E9E"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnConfirmPayment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Payer"
                    android:backgroundTint="#fec87e"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>