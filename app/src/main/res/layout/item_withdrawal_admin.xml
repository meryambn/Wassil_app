<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:elevation="2dp">

    <!-- Amount + status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvWAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1000 DA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/tvWStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En attente"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:background="#f57c0d"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWCourier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Livreur Test"
        android:textSize="14sp"
        android:textColor="#424242"/>

    <TextView
        android:id="@+id/tvWDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-08-13"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginBottom="4dp"/>

    <!-- Shown only when the server actually stored one -->
    <TextView
        android:id="@+id/tvWNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motif: ..."
        android:textSize="12sp"
        android:textColor="#C62828"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvWRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Réf: ..."
        android:textSize="12sp"
        android:textColor="#2E7D32"
        android:visibility="gone"/>

    <!-- Actions. Which of these is visible depends on the row's status;
         the server re-checks every action regardless. -->
    <LinearLayout
        android:id="@+id/llWActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnWReject"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Rejeter"
            android:textSize="12sp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnWApprove"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Approuver"
            android:textSize="12sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"/>

        <!-- Shown on 'approved' rows: the payout was authorised but cannot be
             completed, so it is abandoned and the courier is refunded. -->
        <Button
            android:id="@+id/btnWCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Annuler"
            android:textSize="12sp"
            android:backgroundTint="#6D4C41"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnWMarkPaid"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Marquer payé"
            android:textSize="12sp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
